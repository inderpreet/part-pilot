# Copy to ".env" (same folder you run the app from, or next to the executable) and edit.
# Real environment variables override this file; command-line flags override both.

# Who can connect:
#   localhost  - only this machine (default)
#   all        - every network interface (0.0.0.0), e.g. tablets on the LAN. Plain HTTP; allow the port in your firewall.
#   <ip/host>  - a specific interface address, e.g. 192.168.1.20
# CLI: --bind all
INVENTORY_BIND=localhost

# Port to listen on (default 5080).   CLI: --port 5080
INVENTORY_PORT=5080

# SQLite file (default: inventory.db next to the executable).   CLI: --db C:\data\inventory.db
# INVENTORY_DB=

# Full URL override; takes precedence over BIND/PORT (same as --urls / ASPNETCORE_URLS).
# ASPNETCORE_URLS=http://0.0.0.0:5080

# Disable the rolling log files in <db folder>/logs
# Logging__File__Enabled=false
