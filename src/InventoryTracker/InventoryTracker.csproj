<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Static assets ship inside the executable and are served via ManifestEmbeddedFileProvider. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- web.config is only for IIS; it would be an extra loose file next to the executable. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- We serve wwwroot ourselves (embedded manifest); the SDK's static-web-assets endpoints.json would be another loose file. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- The executable's own icon; the same file the browser gets as /favicon.ico (scripts/make-icons.ps1 builds it from branding/icon.jpg). -->
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Single-file, self-contained publish (architecture §10). Only active when a RuntimeIdentifier is given, i.e.
    `dotnet publish -r <rid>` (see scripts/publish.ps1), so normal builds and tests are unaffected.
    No trimming / Native AOT: EF Core and Razor are not AOT-safe.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>

</Project>
