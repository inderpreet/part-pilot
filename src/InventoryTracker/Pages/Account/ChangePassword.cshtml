@page "/Account/ChangePassword"
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Header"] = "plain";
}

<article class="auth-card">
    <form method="post" novalidate>
        <partial name="_ValidationSummary" model="ViewData.ModelState" />

        <label>
            Current password
            <input name="Input.CurrentPassword" type="password" autocomplete="current-password" autofocus required
                   aria-invalid="@Html.AriaInvalid("Input.CurrentPassword")" aria-describedby="@Html.DescribedBy("Input.CurrentPassword")" />
            @Html.FieldError("Input.CurrentPassword")
        </label>
        <label>
            New password
            <input name="Input.NewPassword" type="password" autocomplete="new-password" minlength="8" required
                   aria-invalid="@Html.AriaInvalid("Input.NewPassword")" aria-describedby="@Html.DescribedBy("Input.NewPassword", "pw-help")" />
            @Html.FieldError("Input.NewPassword")
            <small id="pw-help">At least 8 characters.</small>
        </label>
        <label>
            Confirm new password
            <input name="Input.ConfirmPassword" type="password" autocomplete="new-password" required
                   aria-invalid="@Html.AriaInvalid("Input.ConfirmPassword")" aria-describedby="@Html.DescribedBy("Input.ConfirmPassword")" />
            @Html.FieldError("Input.ConfirmPassword")
        </label>

        <button type="submit">Change password</button>
    </form>
</article>
