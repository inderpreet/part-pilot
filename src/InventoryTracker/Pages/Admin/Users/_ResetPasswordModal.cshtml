@model InventoryTracker.Services.UserDto
<article>
    <header>
        <button type="button" aria-label="Close" rel="prev" data-close-modal></button>
        <p><strong>Reset password for @Model.UserName</strong></p>
    </header>
    <form hx-post="@Url.Page("/Admin/Users/Edit", "ResetPassword", new { id = Model.Id })" hx-target="#reset-errors" hx-swap="innerHTML">
        <div id="reset-errors" aria-live="polite"></div>
        <label>
            New password
            <input name="newPassword" type="password" autocomplete="new-password" minlength="8" autofocus required />
            <small>At least 8 characters. They will be signed out on their other devices and any lockout is cleared.</small>
        </label>
        <label>
            Confirm new password
            <input name="confirmPassword" type="password" autocomplete="new-password" required />
        </label>
        <footer>
            <button type="button" class="secondary" data-close-modal>Cancel</button>
            <button type="submit">Reset password</button>
        </footer>
    </form>
</article>
