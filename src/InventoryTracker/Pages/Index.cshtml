@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

@* The block refreshes itself every minute through htmx (the response is just the partial). Without JavaScript it is a normal page. *@
<div id="dashboard" hx-get="/" hx-trigger="every 60s" hx-swap="innerHTML">
    <partial name="_Dashboard" model="Model" />
</div>
