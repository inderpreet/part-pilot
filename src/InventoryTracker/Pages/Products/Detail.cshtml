@page "/Products/{id:int}"
@model InventoryTracker.Pages.Products.DetailModel
@{
    var p = Model.Product;
    ViewData["Title"] = $"{p.Sku} · {p.Name}";
    ViewData["Crumb"] = p.Sku;
}

@section Leading {
    <a asp-page="Index">‹ All products</a>
}

@section Badges {
    @if (!p.IsActive)
    {
        <span class="badge badge-inactive">Archived</span>
    }
    @if (p.IsLowStock)
    {
        <span class="badge badge-low">Low stock</span>
    }
}

@section Actions {
    @if (Model.CanEdit)
    {
        @if (p.IsActive)
        {
            <div class="move-buttons" role="group" aria-label="Record stock movement">
                <partial name="_MoveButtons" model="@(new MoveButtonsModel(p.Id, p.Sku))" />
            </div>
        }
        <a role="button" class="secondary outline" asp-page="Edit" asp-route-id="@p.Id">Edit</a>
        <form method="post" asp-page-handler="Archive" asp-route-id="@p.Id">
            <input type="hidden" name="active" value="@(p.IsActive ? "false" : "true")" />
            <input type="hidden" name="rowVersion" value="@p.RowVersion" />
            @if (p.IsActive)
            {
                <button type="submit" class="text danger"
                        hx-post="@Url.Page("Detail", "Archive", new { id = p.Id })"
                        hx-confirm="Archive @p.Sku? It will be hidden from pickers and the default list, and its history is kept.">Archive</button>
            }
            else
            {
                <button type="submit" class="secondary outline"
                        hx-post="@Url.Page("Detail", "Archive", new { id = p.Id })"
                        hx-confirm="Restore @p.Sku so it can be used again?">Restore</button>
            }
        </form>
    }
}

@{
    var stockTone = p.QuantityOnHand <= 0 ? "is-zero" : p.IsLowStock ? "is-low" : null;
}

<div class="detail-layout">
    <article class="card on-hand-card @stockTone" aria-label="Quantity on hand">
        <p class="stat-label">On hand</p>
        <p class="on-hand-number">@p.QuantityOnHand</p>
        <p class="on-hand-unit">@p.Unit</p>
        @if (p.ReorderPoint > 0)
        {
            <p class="on-hand-note">Reorder at @p.ReorderPoint</p>
        }
    </article>

    <section class="card" aria-label="Product details">
        <div class="card-head"><h2 class="card-title">Details</h2></div>
        <dl class="detail-grid">
            <dt>SKU</dt>
            <dd>@p.Sku</dd>
            <dt>Name</dt>
            <dd>@p.Name</dd>
            <dt>Description</dt>
            <dd>@(string.IsNullOrWhiteSpace(p.Description) ? "—" : p.Description)</dd>
            <dt>Category</dt>
            <dd>
                @if (p.CategoryId is not null)
                {
                    <a asp-page="Index" asp-route-categoryId="@p.CategoryId" asp-route-status="All">@p.CategoryName</a>
                    @if (!p.CategoryIsActive)
                    {
                        <small class="muted">(archived)</small>
                    }
                }
                else
                {
                    <span>—</span>
                }
            </dd>
            <dt>Unit</dt>
            <dd>@p.Unit</dd>
            <dt>Barcode</dt>
            <dd>@(p.Barcode ?? "—")</dd>
            <dt>Bin location</dt>
            <dd>@(p.BinLocation ?? "—")</dd>
            <dt>Reorder point</dt>
            <dd>@p.ReorderPoint</dd>
            <dt>Reorder quantity</dt>
            <dd>@p.ReorderQuantity</dd>
            <dt>Unit cost</dt>
            <dd>@Html.Money(p.UnitCostCents)</dd>
            <dt>Stock value</dt>
            <dd>@Html.Money(Model.StockValueCents)</dd>
            <dt>Added</dt>
            <dd>@Html.LocalTime(p.CreatedAt)</dd>
            <dt>Last changed</dt>
            <dd>@Html.LocalTime(p.UpdatedAt)</dd>
        </dl>
    </section>
</div>

@* In-page navigation: each section is switched on by the feature that fills it (History: F03, Suppliers: F04, Purchase orders: F05,
   Audit: F08). site.js marks the link for the current hash; without JavaScript History stays marked. *@
<nav class="section-nav" aria-label="More about this product">
    <a href="#history" aria-current="true">History</a>
    <a href="#suppliers">Suppliers</a>
    <a href="#purchase-orders">Purchase orders</a>
    @if (Model.UsedInProjects.Count > 0)
    {
        <a href="#projects">Projects</a>
    }
    <span class="section-nav-soon" aria-disabled="true" title="Coming soon">Audit <small>Soon</small></span>
</nav>

<section id="history" class="card" aria-label="Stock history">
    <div class="card-head">
        <h2 class="card-title">History</h2>
        <a asp-page="/Stock/Movements" asp-route-productId="@p.Id">All movements for this product, with filters</a>
    </div>
    <partial name="_StockHistory" model="Model" />
</section>

<section id="suppliers" class="card" aria-label="Suppliers of this product">
    <div class="card-head"><h2 class="card-title">Suppliers</h2></div>
    <partial name="_SupplierLinks" model="Model.Suppliers" />
</section>

<section id="purchase-orders" class="card" aria-label="Open purchase orders for this product">
    <div class="card-head"><h2 class="card-title">Open purchase orders</h2></div>
    @if (Model.InDraft is { } inDraft)
    {
        <p class="card-note" id="in-draft-pos">
            <strong>In draft POs: @inDraft.Total @p.Unit</strong>
            <span class="muted">(not placed yet, so not counted as on order):</span>
            @for (var i = 0; i < inDraft.Orders.Count; i++)
            {
                var draft = inDraft.Orders[i];
                @if (i > 0)
                {
                    <text>, </text>
                }
                <a asp-page="/PurchaseOrders/Detail" asp-route-id="@draft.PurchaseOrderId">@draft.Number</a> <small class="muted">(@draft.Quantity)</small>
            }
        </p>
    }
    @if (Model.OpenOrders.Count == 0)
    {
        <p class="card-empty muted">Nothing is on order for this product.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Order</th>
                        <th scope="col">Supplier</th>
                        <th scope="col">Status</th>
                        <th scope="col">Expected</th>
                        <th scope="col" class="num">Ordered</th>
                        <th scope="col" class="num">Received</th>
                        <th scope="col" class="num">Outstanding</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.OpenOrders)
                    {
                        var overdue = PurchaseOrderDisplay.IsOverdue(line.Status, line.ExpectedDate, DateOnly.FromDateTime(DateTime.Now));
                        <tr>
                            <td><a asp-page="/PurchaseOrders/Detail" asp-route-id="@line.PurchaseOrderId">@line.Number</a></td>
                            <td><a asp-page="/Suppliers/Detail" asp-route-id="@line.SupplierId">@line.SupplierName</a></td>
                            <td><partial name="_PoStatusBadge" model="line.Status" /></td>
                            <td class="@(overdue ? "po-overdue" : null)">@PurchaseOrderDisplay.Date(line.ExpectedDate)</td>
                            <td class="num">@line.QuantityOrdered</td>
                            <td class="num">@line.QuantityReceived</td>
                            <td class="num"><strong>@line.Outstanding</strong> @p.Unit</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row" colspan="6">On order</th>
                        <td class="num"><strong>@Model.OpenOrders.Sum(l => l.Outstanding)</strong> @p.Unit</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</section>

@if (Model.UsedInProjects.Count > 0)
{
    <section id="projects" class="card" aria-label="Projects that use this product">
        <div class="card-head"><h2 class="card-title">Used in projects</h2></div>
        <div class="table-wrap">
            <table class="striped compact">
                <thead>
                    <tr>
                        <th scope="col">Project</th>
                        <th scope="col" class="num">Per unit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var use in Model.UsedInProjects)
                    {
                        <tr>
                            <td>
                                <a asp-page="/Projects/Detail" asp-route-id="@use.ProjectId">@use.Number</a> @use.Name
                                @if (!use.IsActive)
                                {
                                    <span class="badge badge-inactive">Archived</span>
                                }
                            </td>
                            <td class="num">@use.QuantityPerUnit @p.Unit</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}