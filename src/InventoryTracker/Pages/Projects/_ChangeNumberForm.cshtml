@model InventoryTracker.Pages.Projects.DetailModel
@using InventoryTracker.Data.Entities
@{
    var modal = Model.IsHtmx();
    var postUrl = Url.Page("Detail", "ChangeNumber", new { id = Model.Project.Id })!;
}
<form method="post" action="@postUrl" novalidate
      hx-post="@(modal ? postUrl : null)" hx-target="@(modal ? "this" : null)" hx-swap="@(modal ? "outerHTML" : null)">
    <partial name="_ValidationSummary" model="Model.ModelState" />
    <input type="hidden" name="rowVersion" value="@Model.Project.RowVersion" />

    <p>Current number: <strong>@Model.Project.Number</strong></p>
    <p class="muted">Other systems may refer to the current project number. Purchase orders are not affected.</p>

    <label>
        New project number
        <input name="newNumber" value="@Model.NewNumber" maxlength="@Project.NumberMaxLength" required autofocus autocomplete="off" spellcheck="false"
               aria-invalid="@Html.AriaInvalid(ProjectFields.Number)" aria-describedby="@Html.DescribedBy(ProjectFields.Number)" />
        @Html.FieldError(ProjectFields.Number)
    </label>

    @if (modal)
    {
        <footer>
            <button type="button" class="text" data-close-modal>Cancel</button>
            <button type="submit">Change number</button>
        </footer>
    }
    else
    {
        <div class="form-actions">
            <button type="submit">Change number</button>
            <a role="button" class="text" asp-page="Detail" asp-route-id="@Model.Project.Id">Cancel</a>
        </div>
    }
</form>
