@model InventoryTracker.Pages.Reports.DeadStockModel
@using InventoryTracker.Hosting
@{
    var report = Model.Report;
}
@if (report.Page.TotalCount == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateModel(
        Model.IsFiltered ? "No dead stock matches" : "No dead stock",
        Model.IsFiltered
            ? "Try a different search or category."
            : $"Every part with stock has moved in the last {Model.Query.SafeDays} days. Try a shorter period to see slower movers."))" />
}
else
{
    <div class="report-bar">
        <p>@report.Totals.Products.ToString("N0") @(report.Totals.Products == 1 ? "part" : "parts") idle for @Model.Query.SafeDays+ days · @report.Totals.Units.ToString("N0") units · <strong>@Html.Money(report.Totals.ValueCents)</strong> tied up</p>
        <a role="button" class="outline" href="@Model.CsvUrl()" download>Download CSV</a>
    </div>
    <div class="table-wrap">
        <table class="striped">
            <thead>
                <tr>
                    <partial name="_SortHeader" model="@(new SortHeaderModel("sku", "SKU", Model.Query))" />
                    <partial name="_SortHeader" model="@(new SortHeaderModel("name", "Name", Model.Query))" />
                    <partial name="_SortHeader" model="@(new SortHeaderModel("category", "Category", Model.Query))" />
                    <partial name="_SortHeader" model="@(new SortHeaderModel("onhand", "On hand", Model.Query, Numeric: true))" />
                    <partial name="_SortHeader" model="@(new SortHeaderModel("value", "Value", Model.Query, Numeric: true))" />
                    <partial name="_SortHeader" model="@(new SortHeaderModel("last", "Last movement", Model.Query))" />
                </tr>
            </thead>
            <tbody>
                @foreach (var row in report.Page.Items)
                {
                    <tr>
                        <td><a asp-page="/Products/Detail" asp-route-id="@row.ProductId">@row.Sku</a></td>
                        <td>@row.Name</td>
                        <td>@(row.CategoryName ?? "—")</td>
                        <td class="num">@row.OnHand @row.Unit</td>
                        <td class="num">@Html.Money(row.ValueCents)</td>
                        <td>
                            @if (row.LastMovementAt is { } last)
                            {
                                @Html.LocalDate(last)
                            }
                            else
                            {
                                <span class="muted">Never</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="report-total">
                <tr>
                    <th scope="row" colspan="3">Total, all @report.Totals.Products.ToString("N0") @(report.Totals.Products == 1 ? "part" : "parts")</th>
                    <td class="num">@report.Totals.Units.ToString("N0")</td>
                    <td class="num">@Html.Money(report.Totals.ValueCents)</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <partial name="_Pager" model="@PagerModel.From(report.Page)" />
}
