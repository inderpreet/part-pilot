@model NavItem
@{
    // The layout works out the single current item (the longest matching address) and the badge counts.
    var current = ViewData["NavCurrentHref"] as string == Model.Href;
    var badge = Model.LowStockBadge ? ViewData["LowStockCount"] as int? ?? 0
        : Model.ApprovalsBadge ? ViewData["ApprovalsCount"] as int? ?? 0
        : 0;
    var badgeText = Model.LowStockBadge ? $"{badge} low-stock {(badge == 1 ? "part" : "parts")}" : $"{badge} awaiting a decision";
}
@if (Model.Available)
{
    <li><a href="@Model.Href" aria-current="@(current ? "page" : null)"><svg class="ico" aria-hidden="true"><use href="#i-@Model.Icon"/></svg><span>@Model.Label</span>@if (badge > 0)
        {
            <small class="rail-badge" title="@badgeText"><span class="visually-hidden">@badgeText</span><span aria-hidden="true">@(badge > 99 ? "99+" : badge.ToString())</span></small>
        }</a></li>
}
else
{
    <li class="rail-soon"><svg class="ico" aria-hidden="true"><use href="#i-@Model.Icon"/></svg><span aria-disabled="true" title="Coming soon">@Model.Label</span><small>Soon</small></li>
}
