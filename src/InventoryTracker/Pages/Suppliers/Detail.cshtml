@page "/Suppliers/{id:int}"
@model InventoryTracker.Pages.Suppliers.DetailModel
@{
    var s = Model.Supplier;
    ViewData["Title"] = s.Name;
}

<div class="toolbar">
    <p class="muted">
        <a asp-page="Index">‹ All suppliers</a>
        @if (!s.IsActive)
        {
            <span class="badge badge-inactive">Archived</span>
        }
    </p>

    @if (Model.CanEdit)
    {
        <div class="form-actions">
            <a role="button" asp-page="Edit" asp-route-id="@s.Id">Edit</a>
            <form method="post" asp-page-handler="Archive" asp-route-id="@s.Id">
                <input type="hidden" name="active" value="@(s.IsActive ? "false" : "true")" />
                <input type="hidden" name="rowVersion" value="@s.RowVersion" />
                @if (s.IsActive)
                {
                    <button type="submit" class="secondary outline"
                            hx-post="@Url.Page("Detail", "Archive", new { id = s.Id })"
                            hx-confirm="Archive @s.Name? It can no longer be chosen for new purchase orders or product links; existing ones are kept.">Archive</button>
                }
                else
                {
                    <button type="submit" class="secondary outline"
                            hx-post="@Url.Page("Detail", "Archive", new { id = s.Id })"
                            hx-confirm="Restore @s.Name so it can be used again?">Restore</button>
                }
            </form>
        </div>
    }
</div>

@if (!s.IsActive)
{
    <p role="status" class="muted">This supplier is archived. It cannot be chosen for new purchase orders; existing orders are unaffected.</p>
}

<article>
    <dl class="detail-grid">
        <dt>Name</dt>
        <dd>@s.Name</dd>
        <dt>Contact</dt>
        <dd>@(s.ContactName ?? "—")</dd>
        <dt>Email</dt>
        <dd>
            @if (s.Email is { } email)
            {
                <a href="mailto:@email">@email</a>
            }
            else
            {
                <span>—</span>
            }
        </dd>
        <dt>Phone</dt>
        <dd>
            @if (s.Phone is { } phone)
            {
                <a href="tel:@phone">@phone</a>
            }
            else
            {
                <span>—</span>
            }
        </dd>
        <dt>Website</dt>
        <dd>
            @if (s.Website is { } website)
            {
                <a href="@website" target="_blank" rel="noopener noreferrer">@website</a>
            }
            else
            {
                <span>—</span>
            }
        </dd>
        <dt>Address</dt>
        <dd class="pre-line">@(s.Address ?? "—")</dd>
        <dt>Notes</dt>
        <dd class="pre-line">@(s.Notes ?? "—")</dd>
        <dt>Added</dt>
        <dd>@Html.LocalTime(s.CreatedAt)</dd>
        <dt>Last changed</dt>
        <dd>@Html.LocalTime(s.UpdatedAt)</dd>
    </dl>
</article>

<section id="orders" aria-label="Recent purchase orders">
    <h2 class="section-title">Recent purchase orders</h2>
    @if (Model.CanEdit && s.IsActive)
    {
        <p><a role="button" class="outline" asp-page="/PurchaseOrders/Edit" asp-route-supplierId="@s.Id">New purchase order</a></p>
    }
    @if (Model.RecentOrders.Count == 0)
    {
        <p class="muted">No purchase orders for this supplier yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="striped compact">
                <thead>
                    <tr>
                        <th scope="col">Number</th>
                        <th scope="col">Status</th>
                        <th scope="col">Ordered</th>
                        <th scope="col">Expected</th>
                        <th scope="col" class="num">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td><a asp-page="/PurchaseOrders/Detail" asp-route-id="@order.Id">@order.Number</a></td>
                            <td><partial name="_PoStatusBadge" model="order.Status" /></td>
                            <td>@PurchaseOrderDisplay.Date(order.OrderDate)</td>
                            <td>@PurchaseOrderDisplay.Date(order.ExpectedDate)</td>
                            <td class="num">@Html.Money(order.TotalCents)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p><a asp-page="/PurchaseOrders/Index" asp-route-supplierId="@s.Id" asp-route-tab="All">All orders for this supplier</a></p>
    }
</section>

<section aria-label="Products this supplier provides">
    <h2 class="section-title">Products</h2>
    <partial name="_SupplierLinks" model="Model.Links" />
</section>
